NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 — image storage for post media + avatars (S3-compatible).
# SERVER-SIDE (never exposed to the browser):
# R2_ACCOUNT_ID=            (Cloudflare dashboard → R2 → account id, or the 32-hex id in the API token)
# R2_ACCESS_KEY_ID=         (R2 → Manage R2 API tokens → Create token → "Use S3 clients" keys)
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=                (e.g. student-voice-images)
# R2_PUBLIC_URL=            (public bucket domain, e.g. https://pub-abc123.r2.dev — enable via
#                            R2 bucket → Settings → Public access → R2.dev subdomain; or a
#                            custom domain like https://images.yourdomain.com)

# Only needed by scripts/migrate-supabase-to-r2.mjs (run locally, never commit):
# SUPABASE_SERVICE_ROLE_KEY=